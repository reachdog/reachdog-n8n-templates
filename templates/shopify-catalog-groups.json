    {
      "name": "Prepare request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const s=$input.first().json;\nfunction sorted(x){if(Array.isArray(x))return x.map(sorted);if(x&&typeof x==='object')return Object.fromEntries(Object.keys(x).sort().map(k=>[k,sorted(x[k])]));return x;}\nconst identity={body:s.body,run_label:$('Configuration').first().json.run_label};\nif(s.step==='row')identity.client_product_id=s.body.client_product_id;\nreturn [{json:{...s,canonical:JSON.stringify(sorted(identity))}}];"
      },
