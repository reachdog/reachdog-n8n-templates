    {
      "name": "Prepare input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const cfg=$('Configuration').first().json;\nif(!/^https:\\/\\/[a-z0-9.-]+(:\\d+)?$/i.test(cfg.api_origin)||!cfg.spreadsheet_id.trim())throw new Error('Set HTTPS API origin and spreadsheet ID');\nconst rows=$input.all().map(x=>x.json),records=[],excluded=[];\nif(rows.length>500)throw new Error('Store exceeds 500 products. No catalog submitted.');\nfor(const p of rows){const gid=String(p.admin_graphql_api_id||'').match(/^gid:\\/\\/shopify\\/Product\\/(\\d+)$/);\n const id=gid?.[1]??(Number.isSafeInteger(p.id)||typeof p.id==='string'?String(p.id):'');\n if(!/^\\d+$/.test(id))throw new Error('Invalid Shopify product ID');\n const client_product_id='shopify-'+id;\n if(!p.title?.trim()){excluded.push({source_row:client_product_id,client_product_id,reason:'missing title'});continue;}\n const body={client_product_id,title:p.title};if(p.body_html)body.description=p.body_html;records.push(body);}\nrecords.sort((a,b)=>a.client_product_id<b.client_product_id?-1:1);\nreturn [{json:{records,excluded}}];"
      },
      "position": [580, 0],
      "id": "ac025390-0001-4000-a001-000000000004"
    },
