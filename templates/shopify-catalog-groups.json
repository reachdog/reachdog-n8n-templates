    {
      "name": "Handle response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const r=$input.first().json,s={...$('Hash request').last().json};\ndelete s.canonical;delete s.digest;\nconst status=Number(r.statusCode||0),attempt=s.attempt||0;\nconst header=r.headers?.['retry-after'];\nconst seconds=header==null?2**(attempt+1):/^\\d+(\\.\\d+)?$/.test(String(header))?Number(header):Math.max(0,(Date.parse(header)-Date.now())/1000);\nif(((!status&&r.error)||[500,502,503,504].includes(status))&&attempt<3&&Number.isFinite(seconds)&&seconds<=60)return [{json:{...s,route:'wait',delay:Math.max(1,Math.ceil(seconds)),attempt:attempt+1}}];\ns.attempt=0;\nlet b;try{b=JSON.parse(r.body);}catch{b=null;}\nconst failed=!b||status<200||status>=300;\nconst error=failed?String(b?.code||status||'transport error')+(status===410?' - set a new run_label and rerun':''):'';\nconst next=route=>[{json:{...s,route}}];\nif(failed){s.error=error;return next('error');}\nif(s.step!=='page'){\n if(typeof b.id!=='string'||!b.id)throw new Error('Missing batch ID');\n s.batch_id=b.id;s.batch_path='/v1/batches/'+encodeURIComponent(b.id);\n if(b.billing?.state==='refused'||['failed','cancelled'].includes(b.status)){s.error=b.error?.code||b.status;return next('error');}\n if(b.status==='awaiting_acceptance'){\n  if(s.step!=='quote'||typeof b.billing.acceptance!=='string'||!Number.isFinite(b.billing.quote?.amount)||b.billing.quote.amount<0)throw new Error('Invalid catalog quote');\n  s.acceptance=b.billing.acceptance;s.approval_text=JSON.stringify(b.billing.quote);return next('approve');}\n if(b.status==='completed'){\n  if(!b.result_available||b.billing.state!=='settled'){s.error='results unavailable';return next('error');}\n  s.step='page';s.path=s.batch_path+'/results?page_size=100';s.outputs={catalog_groups:[],group_members:[],catalog_products:[]};s.cursors=[];return next('send');}\n if(!['queued','running','awaiting_quote'].includes(b.status)){s.error='Unknown status '+b.status;return next('error');}\n s.polls=(s.polls||0)+1;if(s.polls>360){s.error='Polling timed out for '+b.id;return next('error');}\n s.step='status';s.path=s.batch_path;s.delay=5;return next('wait');\n}\nfor(const name of Object.keys(s.outputs)){\n if(!Array.isArray(b.outputs?.[name]))throw new Error('Missing output '+name);\n s.outputs[name].push(...b.outputs[name]);}\nif(b.has_more===true){\n if(!b.next_cursor||s.cursors.includes(b.next_cursor))throw new Error('Invalid result cursor');\n s.cursors.push(b.next_cursor);s.path=s.batch_path+'/results?page_size=100&cursor='+encodeURIComponent(b.next_cursor);return next('send');}\nif(b.has_more!==false)throw new Error('Missing pagination flag');\nconst groups=new Map(s.outputs.catalog_groups.map(g=>[g.id,g.label])),members=new Map();\nfor(const g of s.outputs.group_members){\n if(!groups.has(g.id))throw new Error('Missing group label');\n for(const m of g.members){const ids=members.get(m.client_product_id)||[];ids.push(g.id);members.set(m.client_product_id,ids);}}\ns.rows=s.outputs.catalog_products.map(p=>{const ids=members.get(p.client_product_id)||[];\n return {client_product_id:p.client_product_id,title:p.title,group_id:ids.join('; '),group_label:ids.map(id=>groups.get(id)).join('; '),ungrouped:!ids.length};});\nreturn next('rows');"
      },
