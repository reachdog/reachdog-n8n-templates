    {
      "name": "Begin request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const s=$input.first().json; if(!s.records.length)return [];delete s.excluded;s.step='quote';s.path='/v1/batches';s.body={workflow:'catalog_local_v1',records:s.records,parameters:['catalog_products','catalog_groups','group_members'],refine_probes:false};return [{json:s}];"
      },
