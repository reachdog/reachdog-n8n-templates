    {
      "name": "Hash request",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ $json.canonical }}",
        "dataPropertyName": "digest",
        "encoding": "hex"
      },
