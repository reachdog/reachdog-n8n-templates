        "jsCode": "const r = $input.first().json;\nif (r.statusCode !== 200) throw new Error('Usage unavailable: ' + (r.statusCode || 'transport error'));\nconst price = JSON.parse(r.body).parameter_price;\nif (typeof price !== 'number' || !Number.isFinite(price) || price < 0) throw new Error('no price available for this account');\nreturn [{json:{estimate:2 * price}}];"
