    {
      "name": "Interpret receipt",
      "id": "c033014e-2f2f-4660-a775-000000000017",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2820,
        0
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst product = $('Prepare product').first().json.body;\nconst headers = r.headers || {};\nconst receipt = headers['x-charged-tokens'];\nconst settled = headers['x-charge-state'] === 'settled' && /^\\d+$/.test(String(receipt));\nlet body;\ntry { body = JSON.parse(r.body); } catch { body = null; }\nconst ok = r.statusCode >= 200 && r.statusCode < 300;\nconst knownRejection = r.attempts === 1 && ['quota_exceeded','concurrency_exceeded','idempotency_required','invalid_selection','insufficient_credits','wallet_frozen'].includes(body?.code) && r.statusCode >= 400 && r.statusCode < 500 && headers['x-charge-state'] !== 'pending';\nconst state = settled ? 'settled' : knownRejection ? 'released' : 'held';\nconst complete = ok && body?.search_phrases !== undefined && body?.search_volume !== undefined;\nconst row = {client_product_id:product.client_product_id,title:product.title,\n search_phrases:complete ? JSON.stringify(body.search_phrases) : '',search_volume:complete ? JSON.stringify(body.search_volume) : '',\n charge_state:headers['x-charge-state'] || state,charged_tokens:settled ? String(receipt) : '',\n status:complete && settled ? 'completed' : (body?.code || (complete ? 'receipt pending' : 'request failed or response incomplete'))};\nif (r.statusCode === 410) row.status += ': set a new run_label after reconciling the prior operation';\nreturn [{json:{state,amount:settled ? String(receipt) : '0',row}}];"
      }
    },
