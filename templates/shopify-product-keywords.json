    {
      "name": "Handle existing or capped",
      "id": "c033014e-2f2f-4660-a775-000000000020",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        280
      ],
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (result.decision === 'settled' && result.cached_row) return [{json:result.cached_row}];\nif (result.decision === 'held') throw new Error('Existing reservation: reconcile the original execution before retrying');\nif (result.decision !== 'cap') throw new Error('Unexpected reservation outcome');\nconst p = $('Prepare product').first().json.body;\nreturn [{json:{client_product_id:p.client_product_id,title:p.title,search_phrases:'',search_volume:'',charge_state:'skipped',charged_tokens:'',status:'skipped: daily cap reached'}}];"
      }
