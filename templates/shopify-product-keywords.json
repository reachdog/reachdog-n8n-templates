      "parameters": {
        "jsCode": "const cfg = $input.first().json;\nif (!cfg.account.trim() || !cfg.spreadsheet_id.trim() || !/^https:\\/\\/[a-z0-9.-]+(:\\d+)?$/i.test(cfg.api_origin)) throw new Error('Set account, HTTPS API origin and spreadsheet ID');\nif (!/^\\d+$/.test(cfg.daily_cap) || !Number.isSafeInteger(Number(cfg.daily_cap))) throw new Error('Set daily_cap to a nonnegative whole token count');\nconst p = $('New product').first().json;\n// GraphQL ID preserves the full ID even if a webhook JSON number exceeds JS precision.\nconst gid = String(p.admin_graphql_api_id || '').match(/^gid:\\/\\/shopify\\/Product\\/(\\d+)$/);\nconst id = gid?.[1] ?? (Number.isSafeInteger(p.id) || typeof p.id === 'string' ? String(p.id) : '');\nif (!/^\\d+$/.test(id)) throw new Error('Missing lossless Shopify product ID');\nconst client_product_id = 'shopify-' + id;\nif (typeof p.title !== 'string' || !p.title.trim()) return [{json:{excluded:true,client_product_id,status:'excluded: missing title'}}];\nconst body = {client_product_id, title:p.title, parameters:['search_phrases','search_volume']};\nif (typeof p.body_html === 'string' && p.body_html.trim()) body.description = p.body_html;\nfunction sorted(v) {\n  if (Array.isArray(v)) return v.map(sorted);\n  if (v && typeof v === 'object') return Object.fromEntries(Object.keys(v).sort().map(k=>[k,sorted(v[k])]));\n  return v;\n}\nreturn [{json:{excluded:false,body,canonical:JSON.stringify(sorted({client_product_id,body,run_label:cfg.run_label}))}}];"
      }
