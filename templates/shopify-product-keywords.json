        "jsCode": "const r = $input.first().json;\nconst status = Number(r.statusCode || 0);\nconst transient = (!status && !!r.error) || [500,502,503,504].includes(status);\nconst value = r.headers?.['retry-after'];\nconst seconds = value == null ? 2 ** ($runIndex + 1) : /^\\d+(\\.\\d+)?$/.test(String(value)) ? Number(value) : Math.max(0, (Date.parse(value) - Date.now()) / 1000);\nreturn [{json:{...r, attempts:$runIndex + 1, retry:transient && $runIndex < 3 && Number.isFinite(seconds) && seconds <= 60, delay:Math.max(1, Math.ceil(seconds || 1))}}];"
