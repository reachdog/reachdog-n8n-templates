    {
      "name": "Prepare input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const cfg=$('Configuration').first().json;\nif(!/^https:\\/\\/[a-z0-9.-]+(:\\d+)?$/i.test(cfg.api_origin)||!cfg.spreadsheet_id.trim())throw new Error('Set HTTPS API origin and spreadsheet ID');\nconst rows=$input.all().map(x=>x.json),records=[],excluded=[];\nconst counts=new Map();\nfor(const row of rows){const id=String(row.client_product_id??'').trim();counts.set(id,(counts.get(id)||0)+1);}\nfor(const [i,row] of rows.entries()){\n const client_product_id=String(row.client_product_id??'').trim();\n const reason=!client_product_id?'missing ID':counts.get(client_product_id)>1?'duplicate ID':!row.title?.trim()?'missing title':null;\n if(reason){excluded.push({source_row:String(row.row_number??i+2),client_product_id,reason});continue;}\n const body={client_product_id,title:row.title,parameters:['missing_attributes','taxonomy_mappings','product_type']};\n if(row.description)body.description=String(row.description);records.push(body);}\nreturn [{json:{records,excluded,index:0}}];"
      },
      "position": [580, 0],
      "id": "ac025390-0001-4000-a001-000000000004"
    },
    {
      "name": "Excluded rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return $input.first().json.excluded.map(json=>({json}));"
      },
      "position": [800, 290],
      "id": "ac025390-0001-4000-a001-000000000005"
    },
