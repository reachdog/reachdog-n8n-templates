    {
      "name": "Begin request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const s=$input.first().json; if(!s.records.length)return [];delete s.excluded;s.step='usage';s.path='/v1/usage';return [{json:s}];"
      },
      "position": [800, 0],
      "id": "ac025390-0001-4000-a001-000000000007"
    },
    {
      "name": "Prepare request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const s=$input.first().json;\nfunction sorted(x){if(Array.isArray(x))return x.map(sorted);if(x&&typeof x==='object')return Object.fromEntries(Object.keys(x).sort().map(k=>[k,sorted(x[k])]));return x;}\nconst identity={body:s.body,run_label:$('Configuration').first().json.run_label};\nif(s.step==='row')identity.client_product_id=s.body.client_product_id;\nreturn [{json:{...s,canonical:JSON.stringify(sorted(identity))}}];"
      },
      "position": [1020, 0],
      "id": "ac025390-0001-4000-a001-000000000008"
    },
    {
      "name": "Hash request",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ $json.canonical }}",
        "dataPropertyName": "digest",
        "encoding": "hex"
      },
      "position": [1230, 0],
      "id": "ac025390-0001-4000-a001-000000000009"
    },
    {
      "name": "Handle response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const r=$input.first().json,s={...$('Hash request').last().json};\ndelete s.canonical;delete s.digest;\nconst status=Number(r.statusCode||0),attempt=s.attempt||0;\nconst header=r.headers?.['retry-after'];\nconst seconds=header==null?2**(attempt+1):/^\\d+(\\.\\d+)?$/.test(String(header))?Number(header):Math.max(0,(Date.parse(header)-Date.now())/1000);\nif(((!status&&r.error)||[500,502,503,504].includes(status))&&attempt<3&&Number.isFinite(seconds)&&seconds<=60)return [{json:{...s,route:'wait',delay:Math.max(1,Math.ceil(seconds)),attempt:attempt+1}}];\ns.attempt=0;\nlet b;try{b=JSON.parse(r.body);}catch{b=null;}\nconst failed=!b||status<200||status>=300;\nconst error=failed?String(b?.code||status||'transport error')+(status===410?' - set a new run_label and rerun':''):'';\nconst next=route=>[{json:{...s,route}}];\nif(s.step==='usage'){\n if(failed)throw new Error('Usage failed: '+error);\n const price=b.parameter_price;if(typeof price!=='number'||!Number.isFinite(price)||price<0)throw new Error('no price available for this account');\n s.approval_text=s.records.length+' rows x 3 parameters x '+price+' = '+(s.records.length*3*price)+' estimated Reach Dog tokens';\n return next('approve');}\nconst row=s.records[s.index];\nconst incomplete=!failed&&['product_type','missing_attributes','taxonomy_mappings'].some(k=>!(k in b));\ns.row={client_product_id:row.client_product_id,title:row.title,product_type:b?.product_type??'',\n missing_attributes:JSON.stringify(b?.missing_attributes??null),taxonomy_mappings:JSON.stringify(b?.taxonomy_mappings??null),\n charge_state:r.headers?.['x-charge-state']||'unavailable',charged_tokens:r.headers?.['x-charged-tokens']??'',\n error:error||(incomplete?'incomplete response':'')};\nreturn next('rows');"
      },
      "position": [1670, 0],
      "id": "ac025390-0001-4000-a001-000000000011"
    },
