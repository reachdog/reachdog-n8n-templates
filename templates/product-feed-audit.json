      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Configuration').first().json.spreadsheet_id }}",
